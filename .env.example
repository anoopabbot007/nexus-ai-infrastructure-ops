# Local demonstration defaults
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus-local-only
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# mock runs without credentials; choose openai or azure_openai to enable a model
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=15
WORKFLOW_TIMEOUT_SECONDS=120
AGENT_TIMEOUT_MS=130000

# Telemetry uses real Prometheus/Loki data by default. Set mock explicitly for fixtures.
TELEMETRY_MODE=real
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
MCP_SERVER_URL=http://mcp-server:8001/mcp
INVESTIGATION_LOOKBACK_MINUTES=15
MAX_LOG_RESULTS=100
QUERY_STEP_SECONDS=30
TELEMETRY_HTTP_TIMEOUT_SECONDS=8
MCP_TIMEOUT_SECONDS=20
PROMETHEUS_PORT=9090
LOKI_PORT=3100
MCP_PORT=8001
AGENT_SERVICE_PORT=8000
DEMO_TELEMETRY_PORT=8002
ALLOY_PORT=12345
DEMO_SERVICE_NAME=payment-service
DEMO_ENVIRONMENT=production
DEMO_MEMORY_BUDGET_MB=64
# Comma-separated origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
